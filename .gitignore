# Ignore environment files with sensitive credentials
.env
README copy.md
# Ignore local development artifacts
/vendor/
/node_modules/

# Ignore Docker data volumes
db_data/

# Ignore uploaded database files (Excel files)
database/*.xls
database/*.xlsx
database/*.log
database/*.txt

# Keep original JavaScript files for development
# Obfuscated files are generated from these
*.original.js
obfuscate.sh
OBFUSCATION.md

# Ignore backup directory for obfuscation
backup/

# --- TEMP DIRECTORY RULES ---
# Ignore all files inside temp and its subfolders
/temp/**
# But keep all directories
!/temp/
/temp/**/
/temp/**/.gitkeep

# Keep placeholder at root of temp
!/temp/.gitkeep