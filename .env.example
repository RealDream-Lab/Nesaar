# This is an example file. Copy it to .env and fill in your actual values.
# Do NOT commit the .env file to version control.

# --- Web Service (PHP App) ---
# These are read by the PHP application to connect to the database.
DB_HOST=db
DB_NAME=PnuExamsSeatNumber
DB_USER=pnu_user
DB_PASS=a_secure_password_here

# --- Database Service (MySQL) ---
# These are used by the MySQL container on its first run to create the database and user.
# Make sure MYSQL_DATABASE, MYSQL_USER, and MYSQL_PASSWORD match DB_NAME, DB_USER, and DB_PASS.
MYSQL_ROOT_PASSWORD=a_very_secure_root_password
MYSQL_DATABASE=PnuExamsSeatNumber
MYSQL_USER=pnu_user
MYSQL_PASSWORD=a_secure_password_here
